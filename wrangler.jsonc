{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prd-agent",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CREDENTIALS_KV",
      // Replace with your KV namespace IDs from `wrangler kv namespace create CREDENTIALS_KV`
      "id": "<YOUR_KV_NAMESPACE_ID>",
      "preview_id": "<YOUR_KV_PREVIEW_NAMESPACE_ID>",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Set these to match your Plane instance
    "PLANE_CLIENT_ID": "<YOUR_PLANE_CLIENT_ID>",
    "PLANE_BASE_URL": "https://api.plane.so",
    "SERVER_URL": "https://<YOUR_WORKER_NAME>.<YOUR_SUBDOMAIN>.workers.dev",
    "PLANE_BASE_APP_URL": "https://app.plane.so",
  },
}
