{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weather-bot",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CREDENTIALS_KV",
      "id": "fbb8ea005fd047ac87ff765b3f72cb9e",
      "preview_id": "11548798a3ec4106ac457f4104b90d31"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PLANE_CLIENT_ID": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "PLANE_BASE_URL": "http://localhost:8000",
    "SERVER_URL": "http://localhost:8787",
    "PLANE_BASE_APP_URL": "http://localhost:3000",
    "PLANE_CLIENT_SECRET": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "OPENAI_API_KEY": "sk-proj-x1234567890"
  }
}
